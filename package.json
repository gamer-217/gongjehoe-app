{
  "name": "gongjehoe-app",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:i18n && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:rules": "vitest run tests/rules",
    "gen:fixtures": "tsx scripts/gen-fixtures.ts",
    "check:i18n": "tsx scripts/check-i18n.ts",
    "e2e": "playwright test",
    "report:rules": "tsx scripts/report-rules.ts",
    "test:screens": "playwright test tests/a11y; tsx scripts/report-screens.ts",
    "lighthouse": "lhci autorun --config=lighthouserc.cjs && tsx scripts/report-lighthouse.ts",
    "build:single": "vite build --config vite.single.config.ts"
  },
  "dependencies": {
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "i18next": "^26.5.11",
    "lucide-react": "^1.63.0",
    "pretendard": "^1.3.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.1.9",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  }
}
